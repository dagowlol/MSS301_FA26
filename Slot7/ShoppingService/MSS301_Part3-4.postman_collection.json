{
	"info": {
		"_postman_id": "mss301-part3-4-collection",
		"name": "MSS301 – Part 3-4",
		"description": "Test collection cho Part 3 (OpenFeign, Gateway routing) và Part 4 (Keycloak, OAuth2 Resource Server).\n\n**Cách dùng:**\n1. Import collection này vào Postman\n2. Chỉnh sửa biến `clientSecret` trong tab Variables (lấy từ Keycloak Admin Console → Clients → spring-microservices-client → Credentials)\n3. Với các request trong folder `Part4 – Gateway (Authenticated)`: Authorization sẽ tự inherit từ Collection (OAuth2 Client Credentials)\n4. Chạy Runner để test toàn bộ",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "gateway",
			"value": "http://localhost:9000",
			"type": "string"
		},
		{
			"key": "keycloak",
			"value": "http://localhost:8181/realms/spring-microservices-realm",
			"type": "string"
		},
		{
			"key": "clientId",
			"value": "spring-microservices-client",
			"type": "string"
		},
		{
			"key": "clientSecret",
			"value": "THAY_SECRET_CUA_BAN_O_DAY",
			"type": "string"
		},
		{
			"key": "orderServiceUrl",
			"value": "http://localhost:8081",
			"type": "string"
		},
		{
			"key": "inventoryServiceUrl",
			"value": "http://localhost:8082",
			"type": "string"
		},
		{
			"key": "productServiceUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	],
	"auth": {
		"type": "oauth2",
		"oauth2": [
			{ "key": "grant_type", "value": "client_credentials", "type": "string" },
			{ "key": "accessTokenUrl", "value": "{{keycloak}}/protocol/openid-connect/token", "type": "string" },
			{ "key": "clientId", "value": "{{clientId}}", "type": "string" },
			{ "key": "clientSecret", "value": "{{clientSecret}}", "type": "string" },
			{ "key": "client_authentication", "value": "body", "type": "string" },
			{ "key": "tokenName", "value": "MSS301 Token", "type": "string" },
			{ "key": "addTokenTo", "value": "header", "type": "string" }
		]
	},
	"item": [
		{
			"name": "T2 – Inventory Direct",
			"description": "Test trực tiếp Inventory Service (port 8082) – tiền đề cho OpenFeign",
			"item": [
				{
					"name": "T2.1 – Còn hàng (qty=100)",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{inventoryServiceUrl}}/api/inventory?skuCode=iphone_15&quantity=100",
							"host": ["{{inventoryServiceUrl}}"],
							"path": ["api", "inventory"],
							"query": [
								{ "key": "skuCode", "value": "iphone_15" },
								{ "key": "quantity", "value": "100" }
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Body = true (còn hàng)', () => {",
									"    pm.expect(pm.response.text().trim()).to.eql('true');",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "T2.2 – Hết hàng (qty=101)",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
