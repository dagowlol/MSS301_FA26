		{
			"name": "T6 – Keycloak Token",
			"description": "Test lấy token từ Keycloak",
			"item": [
				{
					"name": "T6.3 – Discovery Document",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{keycloak}}/.well-known/openid-configuration",
							"host": ["{{keycloak}}"],
							"path": [".well-known", "openid-configuration"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"pm.test('Có issuer đúng realm', () => {",
									"    pm.expect(json.issuer).to.include('spring-microservices-realm');",
									"});",
									"pm.test('Có token_endpoint', () => {",
									"    pm.expect(json).to.have.property('token_endpoint');",
									"});",
									"pm.test('Hỗ trợ client_credentials', () => {",
									"    pm.expect(json.grant_types_supported).to.include('client_credentials');",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "T6.4 – Lấy token (Client Credentials)",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "grant_type", "value": "client_credentials" },
								{ "key": "client_id", "value": "{{clientId}}" },
								{ "key": "client_secret", "value": "{{clientSecret}}" }
							]
						},
						"url": {
							"raw": "{{keycloak}}/protocol/openid-connect/token",
							"host": ["{{keycloak}}"],
							"path": ["protocol", "openid-connect", "token"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"pm.test('Có access_token', () => {",
									"    pm.expect(json).to.have.property('access_token');",
									"});",
									"pm.test('token_type = Bearer', () => {",
									"    pm.expect(json.token_type).to.eql('Bearer');",
									"});",
									"pm.test('expires_in = 300 (5 phút)', () => {",
									"    pm.expect(json.expires_in).to.eql(300);",
									"});",
									"// Lưu token vào collection variable để dùng lại",
									"if (json.access_token) {",
									"    pm.collectionVariables.set('accessToken', json.access_token);",
									"}"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "T6.6 – Sai secret → 401",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "grant_type", "value": "client_credentials" },
								{ "key": "client_id", "value": "{{clientId}}" },
								{ "key": "client_secret", "value": "sai-secret-hoan-toan" }
							]
						},
						"url": {
							"raw": "{{keycloak}}/protocol/openid-connect/token",
							"host": ["{{keycloak}}"],
							"path": ["protocol", "openid-connect", "token"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
									"pm.test('Error = unauthorized_client', () => {",
									"    pm.expect(pm.response.json().error).to.eql('unauthorized_client');",
									"});"
								]
							}
						}
					],
					"response": []
				}
			]
		},
		{
			"name": "T7 – Gateway 401 Cases (Negative)",
			"description": "Test các trường hợp bị chặn bởi OAuth2 Resource Server",
			"item": [
				{
					"name": "T7.1 – Không có Authorization header → 401",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gateway}}/api/products",
							"host": ["{{gateway}}"],
							"path": ["api", "products"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 401', () => pm.response.to.have.status(401));",
									"pm.test('Có WWW-Authenticate header', () => {",
									"    pm.response.to.have.header('WWW-Authenticate');",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "T7.2 – Token rác → 401",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer abc.def.ghi" }
						],
						"url": {
							"raw": "{{gateway}}/api/products",
							"host": ["{{gateway}}"],
							"path": ["api", "products"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 401', () => pm.response.to.have.status(401));",
									"pm.test('WWW-Authenticate chứa invalid_token', () => {",
									"    const wwwAuth = pm.response.headers.get('WWW-Authenticate');",
									"    pm.expect(wwwAuth).to.include('invalid_token');",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "T7.5 – POST order không token → 401",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"skuCode\": \"iphone_15\",\n    \"price\": 1000,\n    \"quantity\": 1\n}"
						},
						"url": {
							"raw": "{{gateway}}/api/order",
							"host": ["{{gateway}}"],
							"path": ["api", "order"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 401', () => pm.response.to.have.status(401));",
									"pm.test('Có WWW-Authenticate header', () => {",
