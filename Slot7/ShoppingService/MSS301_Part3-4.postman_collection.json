							"host": ["{{inventoryServiceUrl}}"],
							"path": ["api", "inventory"],
							"query": [
								{ "key": "skuCode", "value": "iphone_15" },
								{ "key": "quantity", "value": "101" }
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Body = false (hết hàng)', () => {",
									"    pm.expect(pm.response.text().trim()).to.eql('false');",
									"});"
								]
							}
