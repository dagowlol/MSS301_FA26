							"query": [
								{ "key": "skuCode", "value": "khong_ton_tai" },
								{ "key": "quantity", "value": "1" }
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Body = false (SKU không tồn tại)', () => {",
									"    pm.expect(pm.response.text().trim()).to.eql('false');",
									"});"
								]
							}
						}
					],
					"response": []
