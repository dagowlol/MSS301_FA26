    {
      "name": "04 - Scenario B (CREATE Brand 999)",
      "item": [
        {
          "name": "04.1 - Create Watch with Non-existent Brand 999",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"today\", new Date().toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "var sagaId = pm.response.headers.get(\"X-Saga-Id\");",
                  "pm.test(\"Header X-Saga-Id is present\", function () {",
                  "    pm.expect(sagaId).to.not.be.empty;",
                  "});",
                  "pm.collectionVariables.set(\"sagaId\", sagaId);",
                  "var res = pm.response.json();",
                  "pm.test(\"Saga compensated\", function () {",
                  "    pm.expect(res.data.sagaStatus).to.eql(\"COMPENSATED\");",
                  "    pm.expect(res.data.failedStep).to.eql(\"ASSIGN_BRAND\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
